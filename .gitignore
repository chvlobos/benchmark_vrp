# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Benchmark outputs: results are large; only the final summaries are committed explicitly
results/*
!results/.gitkeep
!results/final/
!results/experiments/
results/experiments/driver*
results/final/*/**/map.html

# Tile cache for basemaps
.tile_cache/

# Hexaly license files never go to git
*.lic
hexaly_license*
license.dat

# Gallery plots are regenerated by `bench report`; only solutions, tables and the report are versioned
results/final/**/*.png
results/experiments/**/*.png
